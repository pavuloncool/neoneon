# .env.local
# Skopiuj ten plik jako .env.local i uzupełnij wartości.

# Sanity (artykuły i tagi) — sanity.io/manage → projekt neoneon
NEXT_PUBLIC_SANITY_PROJECT_ID=n81gbqh8
NEXT_PUBLIC_SANITY_DATASET=production
# Token Viewer — odczyt treści i szkiców komentarzy (server-side)
SANITY_API_READ_TOKEN=sk...
# Token Editor — zapis formularzy (komentarze, kontakt) jako szkice (server-side)
SANITY_API_WRITE_TOKEN=sk...

# Cloudflare Turnstile — Cloudflare → Turnstile → widget „neoneon”
# Klucze testowe (zawsze przechodzą): 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
# Secret — TYLKO server-side
TURNSTILE_SECRET_KEY=0x...

# Adres strony — canonical, hreflang, og:url, sitemap, robots.txt, JSON-LD, link do Studio w mailu.
# Vercel: Production i Preview = https://neoneon.online (podglądy wskazują produkcję jako canonical).
# Brak = https://neoneon.online + ostrzeżenie w logu.
NEXT_PUBLIC_SITE_URL=https://neoneon.online

# Resend — powiadomienia e-mail z formularzy (server-side). Brak = maile wyłączone,
# wpisy dalej trafiają do Sanity, ostrzeżenie w logu.
RESEND_API_KEY=re_...

# Umami — identyfikator witryny (cloud.umami.is). Brak = statystyki wyłączone
# (na produkcji ostrzeżenie w logu). Lokalnie zwykle puste.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Ustawiane przez Vercel automatycznie — NIE wpisywać ręcznie:
# VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV — 'production' włącza indeksowanie (robots.txt, brak X-Robots-Tag)
#   oraz tryb fail-closed formularzy bez kluczy Turnstile. Lokalnie brak = tryb nie-produkcyjny.
# VERCEL_OIDC_TOKEN — dopisywany przez `vercel env pull`.

# Tylko lokalnie, do pomiarów i testów podglądów Vercel z ochroną wdrożeń
# (Protection Bypass for Automation). Nie jest czytana przez aplikację.
VERCEL_BYPASS=
