# .env.local
# Skopiuj ten plik i uzupełnij wartościami z Supabase → Settings → API

# Supabase (publiczne — bezpieczne w przeglądarce)
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase Service Role (TYLKO server-side! nigdy nie ujawniaj w przeglądarce)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Sanity (artykuły i tagi) — sanity.io/manage → projekt neoneon
NEXT_PUBLIC_SANITY_PROJECT_ID=n81gbqh8
NEXT_PUBLIC_SANITY_DATASET=production
# Token Viewer — odczyt draftów w /admin (server-side)
SANITY_API_READ_TOKEN=sk...
# Token Editor — TYLKO lokalnie, do scripts/migrate-to-sanity.mjs; nigdy na Vercel
SANITY_MIGRATION_TOKEN=sk...
